# ==========================================
# Root .gitignore for VoltGrid Luxe System
# ==========================================

# Python Virtual Environments
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
ENV/
**/ENV/

# Python Bytecode & Cache
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
*.so
.Python

# Distribution & Builds
build/
dist/
**/dist/
frontend/dist/
*.egg-info/
*.egg

# Node.js & React Dependencies
node_modules/
**/node_modules/
frontend/node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vite Cache
.vite/
frontend/.vite/
**/.vite/

# Secret Environment Files (Keep .env.example tracked)
.env
backend/.env
**/.env
*.env.local

# Operating System & Editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
